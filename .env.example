# ---------------------------------------------------------------------------
# Public host
# Without a domain, use sslip.io: 203.0.113.10 -> 203-0-113-10.sslip.io
# Caddy issues a Let's Encrypt certificate for it automatically.
# For local development keep "localhost" (Caddy uses its internal CA).
# ---------------------------------------------------------------------------
PUBLIC_HOST=localhost

# Host ports. Keep 80/443 on the VPS (required for Let's Encrypt);
# change them locally if they are already taken.
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_HOST_PORT=5432

# Origins allowed to call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:3000,https://tiagokochemsite.vercel.app

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twin
# Used when running the API outside Docker (uv run ...)
DATABASE_URL=postgresql+asyncpg://twin:change-me@localhost:5432/twin

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Cheaper model for routing, grading and follow-up suggestions
OPENAI_FAST_MODEL=gpt-4.1-nano
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Abuse protection (per client IP / per session)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200
SESSION_MAX_MESSAGES=40
SESSION_MAX_TOKENS=150000

# ---------------------------------------------------------------------------
# Admin (protects /v1/admin/* endpoints). Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp (phase 7)
# BOT number = Evolution instance; OWNER number = Tiago's personal WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_BOT_NUMBER=
WHATSAPP_OWNER_NUMBER=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
