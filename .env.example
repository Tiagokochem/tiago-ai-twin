# ---------------------------------------------------------------------------
# Public host
# Without a domain, use sslip.io: 203.0.113.10 -> 203-0-113-10.sslip.io
# Caddy issues a Let's Encrypt certificate for it automatically.
# For local development keep "localhost" (Caddy uses its internal CA).
# ---------------------------------------------------------------------------
PUBLIC_HOST=localhost
# Full public URL, used in links sent to the owner (e.g. https://203-0-113-10.sslip.io)
PUBLIC_URL=

# Host ports. Keep 80/443 on the VPS (required for Let's Encrypt);
# change them locally if they are already taken.
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_HOST_PORT=5432

# Origins allowed to call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:3000,https://tiagokochemsite.vercel.app

# Sites allowed to embed the chat widget (space separated, used in CSP frame-ancestors)
EMBED_ORIGINS="https://tiagokochemsite.vercel.app"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twin
# Used when running the API outside Docker (uv run ...)
DATABASE_URL=postgresql+asyncpg://twin:change-me@localhost:5432/twin

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Cheaper model for routing, grading and follow-up suggestions
OPENAI_FAST_MODEL=gpt-4.1-nano
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Optional tracing with Langfuse (cloud.langfuse.com free tier or self-hosted)
# Built-in metrics are always available at /api/v1/admin/metrics.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Abuse protection (per client IP / per session)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200
SESSION_MAX_MESSAGES=40
SESSION_MAX_TOKENS=150000
# Idle interviews are closed after this and a summary is sent to the owner
SESSION_IDLE_MINUTES=90

# ---------------------------------------------------------------------------
# Voice (OpenAI speech-to-text and text-to-speech; uses OPENAI_API_KEY)
# ---------------------------------------------------------------------------
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash

# ---------------------------------------------------------------------------
# Admin (protects /v1/admin/* endpoints). Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp via Evolution API
# BOT number    = the number connected to the Evolution instance (talks to recruiters)
# OWNER number  = your personal WhatsApp (only receives handoffs and summaries)
# Webhook URL to configure in Evolution (event MESSAGES_UPSERT):
#   https://<PUBLIC_HOST>/api/v1/channels/whatsapp?token=<EVOLUTION_WEBHOOK_TOKEN>
# Evolution on the same VPS outside this stack: http://host.docker.internal:8080
# ---------------------------------------------------------------------------
WHATSAPP_BOT_NUMBER=
WHATSAPP_OWNER_NUMBER=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Generate with: openssl rand -hex 24
EVOLUTION_WEBHOOK_TOKEN=
WHATSAPP_DEBOUNCE_SECONDS=2.5
WHATSAPP_RATE_PER_MINUTE=8
WHATSAPP_RATE_PER_DAY=150
WHATSAPP_SESSION_IDLE_HOURS=12
